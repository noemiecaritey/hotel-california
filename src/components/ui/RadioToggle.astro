---
// Bouton radio : un clic lance la musique, un second clic la coupe.
// Avec `autoplay`, la musique essaie de démarrer au chargement. Les navigateurs bloquent le son
// tant que le visiteur n'a pas interagi avec la page : dans ce cas, elle démarre à sa première
// interaction (clic, toucher, touche du clavier), sauf s'il a coupé la radio entre-temps.
import RadioOn from '@/assets/images/radio-on.svg';
import RadioOff from '@/assets/images/radio-off.svg';

interface Props {
	/** Fichier audio placé dans public/ (ex. /audio/radio.mp3) */
	src?: string;
	/** Lance la musique dès que le navigateur l'autorise */
	autoplay?: boolean;
	class?: string;
}

const { src = '/audio/radio.mp3', autoplay = false, class: className } = Astro.props;
---

<radio-toggle class:list={['inline-block', className]} data-autoplay={autoplay ? '' : undefined}>
	<button type="button" aria-pressed="false" aria-label="Lancer la musique" class="block h-full cursor-pointer">
		<RadioOff class="h-full w-auto" data-radio-off />
		<RadioOn class="hidden h-full w-auto" data-radio-on />
	</button>
	<audio src={src} loop preload={autoplay ? 'auto' : 'none'}></audio>
</radio-toggle>

<script>
	class RadioToggle extends HTMLElement {
		connectedCallback() {
			const button = this.querySelector('button')!;
			const audio = this.querySelector('audio')!;
			const on = this.querySelector('[data-radio-on]')!;
			const off = this.querySelector('[data-radio-off]')!;

			const render = (playing: boolean) => {
				button.setAttribute('aria-pressed', String(playing));
				button.setAttribute('aria-label', playing ? 'Couper la musique' : 'Lancer la musique');
				on.classList.toggle('hidden', !playing);
				off.classList.toggle('hidden', playing);
			};

			button.addEventListener('click', () => {
				stopWaiting();
				if (audio.paused) audio.play().catch(() => render(false));
				else audio.pause();
			});
			audio.addEventListener('play', () => render(true));
			audio.addEventListener('pause', () => render(false));

			// Démarrage automatique : si le navigateur refuse, on attend la première interaction
			// ailleurs que sur la radio (un clic sur la radio est déjà géré juste au-dessus).
			const interactions = ['pointerdown', 'keydown'] as const;
			const startOnInteraction = (event: Event) => {
				if (this.contains(event.target as Node)) return;
				stopWaiting();
				audio.play().catch(() => render(false));
			};
			const stopWaiting = () => {
				interactions.forEach((type) => document.removeEventListener(type, startOnInteraction));
			};

			if (this.hasAttribute('data-autoplay')) {
				audio.play().catch(() => {
					interactions.forEach((type) => document.addEventListener(type, startOnInteraction));
				});
			}
		}
	}

	customElements.define('radio-toggle', RadioToggle);
</script>
