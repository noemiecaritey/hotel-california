---
// Bouton radio : un clic lance la musique, un second clic la coupe.
// Avec `autoplay`, la musique essaie de démarrer au chargement. Les navigateurs bloquent le son
// tant que le visiteur n'a pas interagi avec la page : dans ce cas, elle démarre à sa première
// interaction (clic, toucher, touche du clavier), sauf s'il a coupé la radio entre-temps.
// Le choix du visiteur est mémorisé : coupée, la radio reste coupée (même au retour sur le site)
// jusqu'à ce qu'il la relance. Entre deux pages, le lecteur est conservé (transition:persist dans
// BaseLayout) et la musique continue ; après un rechargement, elle reprend où elle en était.
import RadioOn from '@/assets/images/radio-on.svg';
import RadioOff from '@/assets/images/radio-off.svg';

interface Props {
	/** Fichier audio placé dans public/ (ex. /audio/radio.mp3) */
	src?: string;
	/** Lance la musique dès que le navigateur l'autorise */
	autoplay?: boolean;
	class?: string;
}

const { src = '/audio/radio.mp3', autoplay = false, class: className } = Astro.props;

// Notes qui sortent de la radio pendant la lecture : décalage horizontal, rotation, retard, couleur.
const notes = [
	{ dx: '-140%', rot: '-25deg', delay: '0s', color: 'text-yellow' },
	{ dx: '-60%', rot: '15deg', delay: '0.6s', color: 'text-red' },
	{ dx: '-180%', rot: '-10deg', delay: '1.2s', color: 'text-blue' },
	{ dx: '-90%', rot: '30deg', delay: '1.8s', color: 'text-yellow' },
];
---

<radio-toggle class:list={['inline-block', className]} data-src={src} data-autoplay={autoplay ? '' : undefined}>
	<button type="button" aria-pressed="false" aria-label="Lancer la musique" class="relative block h-full cursor-pointer transition motion-safe:hover:scale-110">
		<RadioOff class="h-full w-auto" data-radio-off />
		<RadioOn class="hidden h-full w-auto" data-radio-on />
		<span class="pointer-events-none absolute left-[15%] top-[20%]" aria-hidden="true">
			{notes.map((note) => (
				<svg
					class:list={['note absolute h-[3vh] w-auto', note.color]}
					style={`--dx: ${note.dx}; --rot: ${note.rot}; animation-delay: ${note.delay};`}
					viewBox="0 0 24 24"
				>
					<path
						d="M9 3v10.55A4 4 0 1 0 11 17V7h4V3H9z"
						fill="currentColor"
						stroke="#351614"
						stroke-width="1.5"
						stroke-linejoin="round"
					/>
				</svg>
			))}
		</span>
	</button>
</radio-toggle>

<script>
	// UN SEUL lecteur audio pour tout le site, créé une fois et gardé hors de la page (window).
	// Avant, chaque <radio-toggle> avait son propre <audio> : à chaque changement de page, Astro insère un instant
	// la radio de la nouvelle page avant de remettre l'ancienne (transition:persist), ce qui lançait un nouveau
	// lecteur. Sur Safari, les anciens continuaient de jouer : les musiques s'empilaient. Le bouton ne fait
	// maintenant que piloter ce lecteur unique.
	type Fenetre = typeof window & { radioHotelCalifornia?: HTMLAudioElement };

	// Le stockage peut être bloqué (navigation privée, cookies refusés) : la radio marche quand même.
	const lire = (store: Storage, key: string) => {
		try {
			return store.getItem(key);
		} catch {
			return null;
		}
	};
	const ecrire = (store: Storage, key: string, value: string) => {
		try {
			store.setItem(key, value);
		} catch {}
	};

	// Met à jour toutes les radios de la page (icône allumée / éteinte, notes de musique, texte pour les lecteurs d'écran).
	const afficher = (playing: boolean) => {
		document.querySelectorAll<HTMLElement>('radio-toggle').forEach((radio) => {
			const button = radio.querySelector('button')!;
			radio.toggleAttribute('data-playing', playing);
			button.setAttribute('aria-pressed', String(playing));
			button.setAttribute('aria-label', playing ? 'Couper la musique' : 'Lancer la musique');
			radio.querySelector('[data-radio-on]')!.classList.toggle('hidden', !playing);
			radio.querySelector('[data-radio-off]')!.classList.toggle('hidden', playing);
		});
	};

	// Démarrage automatique : si le navigateur refuse (pas encore d'interaction), on attend la première interaction
	// ailleurs que sur la radio (un clic sur la radio est géré par son bouton).
	const interactions = ['pointerdown', 'keydown'] as const;
	const demarrerAuPremierGeste = (event: Event) => {
		if ((event.target as Element).closest?.('radio-toggle')) return;
		arreterAttente();
		lecteur()?.play().catch(() => afficher(false));
	};
	const arreterAttente = () => interactions.forEach((type) => document.removeEventListener(type, demarrerAuPremierGeste));

	const lecteur = () => (window as Fenetre).radioHotelCalifornia;

	// Création du lecteur unique, la première fois qu'une radio apparaît sur le site.
	function creerLecteur(src: string, autoplay: boolean) {
		const audio = new Audio(src);
		audio.loop = true;
		audio.preload = autoplay ? 'auto' : 'none';
		(window as Fenetre).radioHotelCalifornia = audio;

		// Reprise après un rechargement : on note la position pendant la lecture et à la coupure
		// (appliquée une fois le fichier chargé, sinon le navigateur l'ignore).
		const position = Number(lire(sessionStorage, 'radio-position')) || 0;
		audio.addEventListener('loadedmetadata', () => (audio.currentTime = position), { once: true });
		const noterPosition = () => ecrire(sessionStorage, 'radio-position', String(audio.currentTime));
		audio.addEventListener('timeupdate', noterPosition);
		audio.addEventListener('pause', noterPosition);
		audio.addEventListener('play', () => afficher(true));
		audio.addEventListener('pause', () => afficher(false));

		// Coupée la dernière fois : elle reste coupée jusqu'à ce que le visiteur la relance.
		if (autoplay && lire(localStorage, 'radio') !== 'off') {
			audio.play().catch(() => interactions.forEach((type) => document.addEventListener(type, demarrerAuPremierGeste)));
		}
	}

	class RadioToggle extends HTMLElement {
		connectedCallback() {
			// Avec transition:persist, la même radio est déplacée dans chaque nouvelle page : on ne l'initialise qu'une fois.
			if (this.hasAttribute('data-ready')) return;
			this.setAttribute('data-ready', '');

			if (!lecteur()) creerLecteur(this.dataset.src!, this.hasAttribute('data-autoplay'));
			const audio = lecteur()!;
			afficher(!audio.paused);

			this.querySelector('button')!.addEventListener('click', () => {
				arreterAttente();
				ecrire(localStorage, 'radio', audio.paused ? 'on' : 'off');
				if (audio.paused) audio.play().catch(() => afficher(false));
				else audio.pause();
			});
		}
	}

	customElements.define('radio-toggle', RadioToggle);
</script>

<style>
	/* Notes invisibles à l'arrêt ; pendant la lecture elles montent en ondulant puis disparaissent, en boucle. */
	.note {
		opacity: 0;
	}

	@media (prefers-reduced-motion: no-preference) {
		radio-toggle[data-playing] .note {
			animation: note-float 2.4s ease-out infinite;
		}
	}

	@keyframes note-float {
		0% {
			opacity: 0;
			transform: translate(0, 0) rotate(0deg) scale(0.5);
		}
		15% {
			opacity: 1;
		}
		50% {
			transform: translate(calc(var(--dx) * 0.5), -150%) rotate(calc(var(--rot) * -1)) scale(0.9);
		}
		100% {
			opacity: 0;
			transform: translate(var(--dx), -300%) rotate(var(--rot)) scale(1);
		}
	}
</style>
