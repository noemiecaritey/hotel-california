---
import { Image } from 'astro:assets';
import teteHeader from '@/assets/images/tete-header.avif';
import Logo from '@/assets/images/logo-header.svg';
import Star from '@/assets/images/star.svg';
---

<header class="w-full relative m-0">
	<!-- Cadrage de la maquette : image 1.375× plus haute que le bandeau, remontée de 10.9% et décalée de 6.25% vers la droite -->
	<div class="relative m-0 w-full h-[25vh] md:h-[35vh] bg-blue overflow-hidden">
		<Image
			src={teteHeader}
			alt=""
			format="avif"
			class="absolute inset-x-0 top-0 mx-auto h-[137.5%] w-auto max-w-none translate-x-[6.25%] translate-y-[-10.9%]"
		/>
	</div>
	<div class="w-full h-[2.28vh] bg-yellow mt-4">
	</div>
	<div class="w-full h-[2.28vh] bg-yellow mt-2">
	</div>
	<div class="w-full h-[4.09vh] bg-red mt-2">
	</div>
	<Logo class="absolute z-10 h-[17.67vh] w-auto inset-x-0 mx-auto top-[30vh]" />
	<nav class="mx-0 flex bg-brown mt-2 h-[8.53vh] items-center justify-between px-28 align-center">
		<a href="/" class="text-white hover:text-yellow font-rubik-mono transition duration-300 ease-out motion-safe:hover:-translate-y-0.5 text-2xl">Rockstar</a>
		<div class="flex space-x-2">
			<Star class="h-[4vh] w-auto text-[#4CA9C1]" />
			<Star class="h-[4vh] w-auto text-[#4CA9C1]" />
			<Star class="h-[4vh] w-auto text-[#4CA9C1]" />
		</div>
		<a href="/" class="text-white hover:text-yellow font-rubik-mono transition duration-300 ease-out motion-safe:hover:-translate-y-0.5 text-2xl">Single</a>
		<div class="flex space-x-2">
			<Star class="h-[4vh] w-auto text-[#4CA9C1]" />
			<Star class="h-[4vh] w-auto text-[#4CA9C1]" />
			<Star class="h-[4vh] w-auto text-[#4CA9C1]" />
		</div>
		<a href="/" class="text-white hover:text-yellow font-rubik-mono transition duration-300 ease-out motion-safe:hover:-translate-y-0.5 text-2xl">Bestseller</a>
	</nav>
</header>
