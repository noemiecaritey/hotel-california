---
// Card du carousel : taille fixe 444×367 (écran de référence 1280×832).
// Commun à toutes les cards : le titre et les frises d'étoiles. Seule l'image change.
// Avec `href`, la card entière est un lien ; au survol, l'image de droite (`imageSurvol`) remplace l'autre et un
// bandeau « Voir plus » monte depuis le bas.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	// Image importée (src/assets) ou URL (ex : image PocketBase)
	image?: ImageMetadata | string | null;
	alt?: string;
	// Image affichée au survol (URL, ex : vue de droite PocketBase)
	imageSurvol?: string | null;
	// Page ouverte au clic sur la card
	href?: string;
	// Card de la seconde série du carousel : sautée au clavier
	copie?: boolean;
	class?: string;
}

const { image, imageSurvol, alt = '', href, copie = false, class: className } = Astro.props;
const Racine = href ? 'a' : 'div';

// Frise : une bande rouge découpée par un motif d'étoiles répété (public/images/etoile-frise.svg : une étoile de
// 2.21vh et 1.5vh d'espace), qui défile d'un motif à l'infini (animate-frise). Un seul élément au lieu de 72 étoiles.
const frise = 'h-[2.5vh] bg-red animate-frise motion-reduce:animate-none [mask-image:url(/images/etoile-frise.svg)] [mask-size:3.71vh_2.5vh] [mask-repeat:repeat-x]';
---

<Racine
	href={href}
	tabindex={copie && href ? -1 : undefined}
	class:list={[
		'group relative h-[44.11vh] aspect-444/367 shrink-0 flex flex-col overflow-hidden focus-visible:outline-4 focus-visible:outline-yellow focus-visible:-outline-offset-4',
		className,
	]}
>
	<!-- Frise du haut + titre posé par-dessus -->
	<div class="relative">
		<div class="py-[1vh]" aria-hidden="true">
			<div class={frise}></div>
		</div>
		<div class="absolute inset-0 z-10 flex items-center justify-center">
			<span class="bg-blue px-[1vh] font-rubik-mono text-red">Nouveautés</span>
		</div>
	</div>

	<div class="relative flex-1 min-h-0 flex items-center justify-center">
		{typeof image === 'string' ? (
			<img
				src={image}
				alt={alt}
				loading="lazy"
				class:list={['h-full w-auto max-w-full object-contain', imageSurvol && 'transition-opacity duration-300 group-hover:opacity-0']}
			/>
		) : (
			image && <Image src={image} alt={alt} class="h-full w-auto max-w-full object-contain" />
		)}
		{imageSurvol && (
			<img
				src={imageSurvol}
				alt=""
				loading="lazy"
				class="absolute inset-0 size-full object-contain opacity-0 transition-opacity duration-300 group-hover:opacity-100"
			/>
		)}
	</div>

	<div class="py-[1vh]" aria-hidden="true">
		<div class={frise}></div>
	</div>

	<!-- Bandeau « Voir plus » qui monte depuis le bas au survol (et au clavier), comme sur les Bestsellers -->
	{href && (
		<div class="absolute inset-x-0 bottom-0 z-20 translate-y-full bg-brown/85 py-[2vh] text-center font-rubik-mono text-yellow transition-transform duration-300 group-hover:translate-y-0 group-focus-visible:translate-y-0 motion-reduce:transition-none">
			Voir plus
		</div>
	)}
</Racine>
