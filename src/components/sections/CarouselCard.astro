---
// Card du carousel : taille fixe 444×367 (écran de référence 1280×832).
// Commun à toutes les cards : le titre et les frises d'étoiles. Seule l'image change.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	// Image importée (src/assets) ou URL (ex : image PocketBase)
	image?: ImageMetadata | string | null;
	alt?: string;
	// Lien du bouton « Découvrir » qui apparaît au survol (pas de bouton si absent)
	href?: string;
	class?: string;
}

const { image, alt = '', href, class: className } = Astro.props;

// Frise : une bande rouge découpée par un motif d'étoiles répété (public/images/etoile-frise.svg : une étoile de
// 2.21vh et 1.5vh d'espace), qui défile d'un motif à l'infini (animate-frise). Un seul élément au lieu de 72 étoiles.
const frise = 'h-[2.5vh] bg-red animate-frise motion-reduce:animate-none [mask-image:url(/images/etoile-frise.svg)] [mask-size:3.71vh_2.5vh] [mask-repeat:repeat-x]';
---

<div class:list={['group relative h-[44.11vh] aspect-444/367 shrink-0 flex flex-col overflow-hidden', className]}>
	<!-- Frise du haut + titre posé par-dessus -->
	<div class="relative">
		<div class="py-[1vh]" aria-hidden="true">
			<div class={frise}></div>
		</div>
		<div class="absolute inset-0 z-10 flex items-center justify-center">
			<span class="bg-blue px-[1vh] font-rubik-mono text-red">Nouveautés</span>
		</div>
	</div>

	<div class="flex-1 min-h-0 flex items-center justify-center">
		{typeof image === 'string' ? (
			<img src={image} alt={alt} loading="lazy" class="h-full w-auto max-w-full object-contain" />
		) : (
			image && <Image src={image} alt={alt} class="h-full w-auto max-w-full object-contain" />
		)}
	</div>

	<div class="py-[1vh]" aria-hidden="true">
		<div class={frise}></div>
	</div>

	<!-- Au survol (ou au clavier), la card s'assombrit et le bouton apparaît -->
	{href && (
		<div class="absolute inset-0 z-20 flex items-center justify-center bg-brown/60 opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-within:opacity-100">
			<a
				href={href}
				class="bg-yellow px-[2.5vh] py-[1.5vh] font-rubik-mono text-brown transition hover:bg-red hover:text-yellow focus-visible:outline-4 focus-visible:outline-yellow focus-visible:outline-offset-4"
			>
				Découvrir
			</a>
		</div>
	)}
</div>
